# General shorthand {{{
snippet .c
	.catch(()=> $1)

snippet .t
	.then(()=> $1)
snippet @mfdc
	@momsfriendlydevco

snippet class
	export default class $1 {

		constructor(options) {
			Object.assign(this, options);
		}

	}

snippet iif
	(()=> {
	})()

snippet ptimeout
	new Promise(resolve => setTimeout(resolve, $1))

snippet pr
	Promise.resolve()
snippet returnp
	return Promise.resolve()

snippet throwiif
	(()=> { throw new Error('$1') })()

snippet undef
	undefined

snippet un
	undefined
# }}}

# Colors {{{
snippet blue
	app.log.colors.blue($1)

snippet cyan
	app.log.colors.cyan($1)

snippet green
	app.log.colors.green($1)

snippet red
	app.log.colors.red($1)

snippet yellow
	app.log.colors.yellow($1)
# }}}

# Console output {{{
snippet c
	console.log($1);

snippet cj
	console.log(JSON.stringify({$1}, null, '\t'));

snippet console.j
	console.log(JSON.stringify($1, null, '\t'));
# }}}

# Chai {{{
snippet chai
	import {expect} from 'chai';

	describe('$1', ()=> {
		$2
	});

snippet describe
	describe('$1', ()=> {
		$2
	});

snippet it
	it('${1:should}', ()=> {
		$2
	});
# }}}

# Express (`app.something`) {{{
snippet app.get
	app.get('/${1:widgets}', function(req, res) {
		$2
	});

snippet app.post
	app.post('/${1:widgets}', function(req, res) {
		$2
	});
# }}}

# Promises {{{
snippet Promise.t
	import {setTimeout: promiseTimeout} from 'node:timers/promises';
	promiseTimeout($1)

snippet Promise.timeout
	new Promise(resolve => setTimeout(()=> resolve($1), ${2:1000}))

snippet .then
	.then(()=> $1)

snippet .then{
	.then(()=> {
		$1
	})

snippet .thenc
	.then(()=> console.log($1))

snippet .thenf
	// $1 {{{
	.then(()=> $2)
	// }}}

snippet .thens
	// Sanity checks {{{
	.then(()=> {
		$1
	})
	// }}}
# }}}

# Module import / require {{{
snippet "var _"
	var _ = require('lodash');

snippet import
	import ${1/^.*\/(.+)$/$1/} from '$1';

snippet "import _"
	import {$1} from 'lodash';

snippet "import @m"
	import {$1} from '@momsfriendlydevco/${2:1}';

snippet var
	var ${1:module} = require("$1");
# }}}

# Eslint {{{
snippet de
	debugger;

snippet dedl
	debugger; // eslint-disable-line no-debugger

snippet ed
	/* eslint-disable $1 */

snippet edl
	// eslint-disable-line $1
# }}}

# General JSDoc {{{
snippet /**
	/**
	* $1
	*/

snippet /**a
	/**
	* $1
	*
	* @type {Array}
	*/

snippet /**b
	/**
	* $1
	*
	* @type {Boolean}
	*/

snippet /**c
	/**
	* $1
	*
	* @type {Array<Object>}
	*/

snippet /**d
	/**
	* $1
	*
	* @type {Date}
	*/

snippet /**o
	/**
	* $1
	*
	* @type {Object}
	*/

snippet /**s
	/**
	* $1
	*
	* @type {String}
	*/

snippet *
	* @param {$1} $2

snippet @p
	@param {$1} $2

snippet @pr
	@property {$1} $2

snippet @pa
	@param {Array} $1

snippet @pb
	@param {Boolean} $1

snippet @pf
	@param {Function} $1 called as `($2)`

snippet @po
	@param {Object} $1

snippet @pn
	@param {Number} $1

snippet @ps
	@param {String} $1

snippet @ta
	@type {Array}

snippet @tb
	@type {Boolean}

snippet @tf
	@type {Function}

snippet @to
	@type {Object}

snippet @tn
	@type {Number}

snippet @ps
	@param {String} $1

snippet "@param {O"
	@param {Object} [options] Additional options to mutate behaviour

snippet @poo
	@param {Object} [options] Additional options to mutate behaviour

snippet @rp
	@returns {Promise} A promise which resolves when the operation has completed

snippet "@returns {P"
	@returns {Promise} A promise which resolves when the operation has completed

snippet "@returns {O"
	@returns {Object} This chainable instance

snippet lets
	let settings = {
		$1
		...options,
	};

snippet "let s"
	let settings = {
		$1
		...options,
	};

snippet o.
	options.
# }}}

# General JavaScript {{{
snippet //{
		// $1 {{{

snippet //}
		// }}}

snippet .map
	.map(${1:item} => {
		console.log('MAP ${1/^(.*)$/\U$0\E/}:', $1);
		return $1;
	})

snippet .tap
	.then(${1:v} => {
		console.log('TAP', {$1});
		return $1;
	})

snippet .tapj
	.then(${1:v} => {
		console.log('TAP $1 =', JSON.stringify($1, null, '\t'));
		return $1;
	})

snippet .dtap
	.then(v => {
		console.debug('$1', v);
		return v;
	})

snippet .tapd
	.then(v => {
		debug('$1', v);
		return v;
	})

snippet var
	var $1 = require('${1}');

snippet throw
	throw new Error('${1}');
# }}}

# General words {{{
snippet @m
	@momsfriendlydevco

snippet @mfdc
	@momsfriendlydevco
# }}}
